# ============================================================
# Frontend gitignore — Next.js / Node
# ============================================================

# ── Environment & secrets ────────────────────────────────────
.env
.env.*
!.env.local.example

# ── Next.js build output ─────────────────────────────────────
.next/
out/

# ── Node modules ─────────────────────────────────────────────
node_modules/

# ── Package manager locks (keep package-lock, ignore others) ─
yarn.lock
pnpm-lock.yaml

# ── TypeScript build info ────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Test & coverage ──────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
