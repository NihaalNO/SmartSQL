# =============================================================================
# SmartSQL – Backend Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase project credentials
# Find these in: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://yourref.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...           # "anon public" key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  # "service_role secret" key — NEVER expose to frontend
SUPABASE_JWT_SECRET=your-jwt-secret     # Project Settings > API > JWT Secret

# ---------------------------------------------------------------------------
# Neon PostgreSQL connection — used for the internal SmartSQL database.
# Find these values in: Neon Console → your project → Connection Details.
# Host format:  ep-<name>-<id>.<region>.aws.neon.tech
# User:         your role name (default: neondb_owner)
# Database:     your database name (default: neondb)
# SSL is always required for Neon — do not disable it.
# ---------------------------------------------------------------------------
DB_HOST=ep-example-name-id.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-database-password

# ---------------------------------------------------------------------------
# AI Model Providers – configure at least one
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

DEFAULT_MODEL_PROVIDER=groq
DEFAULT_MODEL_NAME=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
