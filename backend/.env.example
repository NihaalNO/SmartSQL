# =============================================================================
# SmartSQL – Backend Environment Variables (TypeScript / Express.js)
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Supabase project credentials
# Find these in: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://yourref.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...           # "anon public" key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  # "service_role secret" key — NEVER expose to frontend
SUPABASE_JWT_SECRET=your-jwt-secret     # Project Settings > API > JWT Secret

# ---------------------------------------------------------------------------
# Direct PostgreSQL connection — used by Prisma
# For Supabase: find your connection string in:
#   Supabase Dashboard → your project → Connect → Session pooler / Direct
# Host format:  db.<project-ref>.supabase.co
# User:         postgres (default)
# Database:     postgres (default)
# SSL is always required for Supabase — do not disable it.
# Port:         5432 (direct), 6543 (session pooler), 6579 (transaction pooler)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
# Optional: path to a CA certificate file for SSL verification
# If set, the server will verify database SSL certificates against this CA.
# If unset, SSL connections will use unverified certificates (rejectUnauthorized: false).
# DB_CA_CERT_PATH=/etc/ssl/certs/ca-certificates.crt

# ---------------------------------------------------------------------------
# AI Model Providers – configure at least one
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

DEFAULT_MODEL_PROVIDER=groq
DEFAULT_MODEL_NAME=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email Verification & Password Reset
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=verify@yoursql.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Used by SmartSQL's direct Google OAuth flow so Google's account chooser
# shows the configured Google app name instead of the Supabase project URL.
# Add the same redirect URI to Google Cloud OAuth Authorized redirect URIs
# and set NEXT_PUBLIC_GOOGLE_REDIRECT_URI in the frontend.

# ---------------------------------------------------------------------------
# Token Secrets
# ---------------------------------------------------------------------------
EMAIL_VERIFICATION_SECRET=your_email_verification_secret
PASSWORD_RESET_SECRET=your_password_reset_secret
EOF
