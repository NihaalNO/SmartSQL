# =============================================================================
# SmartSQL – Backend Environment Variables (TypeScript / Express.js)
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Supabase project credentials
# Find these in: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://yourref.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...           # "anon public" key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  # "service_role secret" key — NEVER expose to frontend
SUPABASE_JWT_SECRET=your-jwt-secret     # Project Settings > API > JWT Secret

# ---------------------------------------------------------------------------
# Direct PostgreSQL connection (Neon) — used by Prisma
# Find these values in: Neon Console → your project → Connection Details.
# Host format:  ep-<name>-<id>.<region>.aws.neon.tech
# User:         your role name (default: neondb_owner)
# Database:     your database name (default: neondb)
# SSL is always required for Neon — do not disable it.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# ---------------------------------------------------------------------------
# AI Model Providers – configure at least one
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

DEFAULT_MODEL_PROVIDER=groq
DEFAULT_MODEL_NAME=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email Verification & Password Reset
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=verify@yoursql.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Note: GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are for Supabase OAuth configuration
# (set in Supabase Dashboard > Authentication > Providers)

# ---------------------------------------------------------------------------
# Token Secrets
# ---------------------------------------------------------------------------
EMAIL_VERIFICATION_SECRET=your_email_verification_secret
PASSWORD_RESET_SECRET=your_password_reset_secret
EOF